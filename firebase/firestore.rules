rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && (
        request.auth.token.role == role || 
        getUserData().role == role
      );
    }
    
    function isStaff() {
      return isAuthenticated() && (
        hasRole('waiter') || 
        hasRole('counter') || 
        hasRole('manager')
      );
    }
    
    function isManager() {
      return isAuthenticated() && hasRole('manager');
    }

    function customerClaim(tableId) {
      let sid = request.resource.data.currentSessionId;
      let session = getAfter(/databases/$(database)/documents/sessions/$(sid)).data;
      let booking = get(/databases/$(database)/documents/reservations/$(session.reservationId)).data;
      let afterBooking = getAfter(/databases/$(database)/documents/reservations/$(session.reservationId)).data;
      let config = get(/databases/$(database)/documents/config/app).data;
      return isAuthenticated()
        && resource.data.status == 'available'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'currentSessionId'])
        && request.resource.data.status == 'occupied'
        && session.customerId == request.auth.uid && session.openedBy == request.auth.uid
        && session.openedByRole == 'customer' && session.status == 'active'
        && session.tableId == tableId && session.tableQrSecret == resource.data.qrSecret
        && booking.customerId == request.auth.uid && booking.tableId == tableId
        && booking.status == 'confirmed'
        && afterBooking.status == 'checked_in' && afterBooking.sessionId == sid
        && request.time >= booking.startTime - duration.value(config.checkInEarlyMinutes, 'm')
        && request.time <= booking.holdUntil
        && session.startedAt >= request.time - duration.value(2, 'm')
        && session.startedAt <= request.time + duration.value(2, 'm')
        && session.expiresAt <= session.startedAt + duration.value(config.sessionMinutes, 'm');
    }

    // App Configuration: read by all authenticated, write only by manager
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManager() || hasRole('counter');
    }

    // Users & Point Transactions
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isStaff() || (isOwner(userId) && request.resource.data.role == 'customer' && request.resource.data.points == 0);
      allow update: if isStaff() || (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phone', 'email', 'fcmTokens', 'bookingRevision']));
      allow delete: if isManager();

      match /pointTx/{txId} {
        allow read: if isOwner(userId) || isStaff();
        allow write: if isStaff();
      }
    }

    // Tables & Slots
    match /tables/{tableId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
      allow update: if customerClaim(tableId);

      match /slots/{slotId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    // Menu Items
    match /menuItems/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // Reservations
    match /reservations/{resId} {
      allow read: if isAuthenticated() && (
        isStaff() || 
        resource.data.customerId == request.auth.uid
      );
      allow create: if isAuthenticated();
      allow delete: if isStaff();
      allow update: if isStaff() || (isAuthenticated() && resource.data.customerId == request.auth.uid
        && resource.data.status == 'confirmed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'sessionId'])
        && (request.resource.data.status == 'cancelled' ||
          (request.resource.data.status == 'checked_in' &&
           getAfter(/databases/$(database)/documents/tables/$(resource.data.tableId)).data.currentSessionId == request.resource.data.sessionId)));
    }

    // Sessions & Orders
    match /sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isStaff() || (isAuthenticated() && resource.data.customerId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['expiresAt', 'extendedMinutes', 'extensions', 'customerId', 'tableId']));
      allow delete: if isManager();

      match /orders/{orderId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isStaff();
        allow delete: if isStaff();
      }
    }

    // Orders collectionGroup for Kitchen / POS display
    match /{path=**}/orders/{orderId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Requests (call_waiter, request_bill, release_table, early_release)
    match /requests/{reqId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.type != 'extend_session' ||
        (request.resource.data.createdBy == request.auth.uid && request.resource.data.status == 'open' &&
         get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.customerId == request.auth.uid &&
         get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.status == 'active'));
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Payments
    match /payments/{payId} {
      allow read: if isAuthenticated() && (
        isStaff() || 
        resource.data.customerId == request.auth.uid
      );
      allow create: if isStaff();
      allow update, delete: if isManager();
    }
  }
}

